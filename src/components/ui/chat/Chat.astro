---
/**
 * Chat — 静态对话转录容器。
 *
 * 只负责排版：把一条或多条 `ChatMessage` 排成对话，不连接任何运行时。
 * 用来在文档里展示「用户说了什么、助手回了什么」，助手侧可以嵌 `OpenUI` 等块级组件。
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"figure"> {
  /** 可选标题，显示在对话顶部，例如「Web 会话」。 */
  title?: string;
}

const { title, class: className, ...attrs } = Astro.props;
---

<figure class={cn("chat not-prose my-4 overflow-hidden rounded-lg ring ring-border", className)} {...attrs}>
	{
		title && (
			<figcaption class="border-b border-border bg-muted/50 px-4 py-2 text-xs font-medium text-muted-foreground">
				{title}
			</figcaption>
		)
	}
	<div class="flex flex-col gap-4 px-4 py-4">
		<slot />
	</div>
</figure>
