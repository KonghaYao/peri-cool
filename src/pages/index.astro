---
import { getCollection } from 'astro:content';
import '../styles/submerged.css';

const base = import.meta.env.BASE_URL;

const sectionLabels: Record<string, string> = {
	engineering: '工程',
	product: '产品',
	research: '研究',
	news: '动态',
};

const posts = (await getCollection('posts'))
	.sort((a, b) => b.id.localeCompare(a.id))
	.slice(0, 4);

const metrics = [
	{ num: '13 MB', label: '二进制' },
	{ num: '~50 MB', label: '常驻内存' },
	{ num: '98%', label: '缓存命中' },
	{ num: '14', label: '核心之器' },
	{ num: '6', label: '内置佐者' },
	{ num: '28', label: 'Hook 事件' },
];

const engineFeatures = [
	{ icon: '🌀', title: 'RCRA Agent Loop', desc: '四阶段执行循环：Receive → Compact → Reason → Act，每轮压缩上下文，500 次循环上限。' },
	{ icon: '🧠', title: 'Compact 上下文压缩', desc: '冻结系统提示词 + 边界标记机制，把窗口还给新信息，压缩后继续推理不断链。' },
	{ icon: '🎛️', title: 'Ultracode 编排引擎', desc: 'JavaScript ESM 脚本驱动的多代理编排：并行扇出、流水线、阶段、条件分支、验证关口、模型分层、收敛循环。' },
	{ icon: '📊', title: 'Workflow 面板', desc: '/workflows 实时监控执行：三级树展示、journal 日志、断点续跑，观察和调试工作流。' },
	{ icon: '🔌', title: 'ACP 协议', desc: 'Agent Client Protocol 双传输层实现——AI 编程工具的通用语言，从 LSP 类比到协议分层。' },
	{ icon: '👥', title: 'Multi-Agent 架构', desc: '子代理系统实现多智能体协作：Agent 定义、派发流程、Fork 模式与后台执行，并行不打架。' },
];

const modelFeatures = [
	{ icon: '🌐', title: '任何模型', desc: 'DeepSeek、GLM、Qwen、Anthropic、OpenAI——不绑定任何一家，国产模型也能驱动 20 万行代码库。' },
	{ icon: '🎚️', title: '四档模型档位', desc: 'fable / opus / sonnet / haiku 四档 Profile 独立配置 provider、模型与费用策略，各司其职。' },
	{ icon: '🔄', title: '会话中热切换', desc: '聊天中途随时切换模型，无需重启。贵的给推理，便宜的给搜索。' },
	{ icon: '💾', title: '缓存命中 98%', desc: '冻结系统提示词 + 边界标记，14 个提示词段落稳定复用，最大限度减少浪费的 token。' },
	{ icon: '📚', title: '上下文工程', desc: '缓存策略、自动压缩与渐进式信息加载——理解 Peri 如何管理窗口，用对模型、控制上下文。' },
	{ icon: '🖼️', title: '图片输入', desc: '截图直接粘贴给 Peri（Ctrl+V），让模型看到界面报错、设计稿、图表数据。' },
];

const agentFeatures = [
	{ icon: '🛠️', title: '14 个核心工具', desc: 'Read/Write/Edit、Glob/Grep、Bash、WebFetch/WebSearch、Agent 委派、TodoWrite……每个工具带别名自动解析。' },
	{ icon: '🧩', title: 'Skills', desc: '可复用的专项能力模块，Peri 自动加载适合当前任务的 skill——探索、审查、重构、修 Bug 都是一句话。' },
	{ icon: '🤖', title: '6 种内置子代理', desc: 'explorer / coder / verification / web-researcher / plan / general-purpose，各有权限边界与模型策略。' },
	{ icon: '🔗', title: 'MCP', desc: '通过 Model Context Protocol 接入外部工具和服务——文件系统、数据库、API 全部打通。' },
	{ icon: '⏱️', title: 'Hook 系统', desc: 'Agent Loop → Hook Middleware → Claude Code Hook 三层管道，28 个生命周期事件驱动自动化。' },
	{ icon: '🛡️', title: '权限系统', desc: '从完全自动到逐条审批，四种权限模式保护你的代码和系统安全。' },
];

const ecoFeatures = [
	{ icon: '🤝', title: 'Claude Code 生态兼容', desc: 'Skills、Hooks、MCP、插件原样可用——你现有的配置直接迁移，零改写。' },
	{ icon: '📦', title: 'AGM 包管理器', desc: 'agm install 任何 skill 或 agent。一把锁文件，所有工具互通。' },
	{ icon: '⏰', title: '定时任务', desc: '自然语言注册重复任务：每天早上 9 点的日报、每周一的依赖更新。到点自动执行。' },
	{ icon: '🎯', title: '/goal 长任务', desc: '声明目标后持续自动推进——命令用法、验收标准、长会话节奏全覆盖，中途走开也没关系。' },
	{ icon: '⚡', title: 'Superpowers 工作流', desc: 'Peri + Superpowers 插件：结构化规划、工程化执行、自动化验证的完整工作流。' },
	{ icon: '📐', title: 'OpenSpec 规格驱动', desc: 'Spec-driven development——先定规格书再写代码，强制 RFC 2119 标准与验收条件。' },
];

const toolCards = [
	{ names: 'Read / Write / Edit', desc: '文件操作：读文件、写文件、精确字符串替换——不依赖行号，因为行号在模型输出时经常不准。' },
	{ names: 'Glob / Grep', desc: '文件搜索：按文件名模式匹配，按文件内容正则搜索，覆盖日常代码探索。' },
	{ names: 'Bash', desc: 'Shell 执行：超时控制、后台运行，跑测试、构建项目、操作 git。' },
	{ names: 'folder_operations', desc: '目录操作：列出内容、创建目录、检查路径，支持深度扫描目录树。' },
	{ names: 'WebFetch / WebSearch', desc: '网络工具：抓取网页为文本，搜索引擎查信息，支持指定结果数量。' },
	{ names: 'Agent', desc: '子代理委派：把独立子任务派发给专用 agent 执行，支持后台运行。' },
	{ names: 'AskUserQuestion / TodoWrite', desc: '交互与任务跟踪：结构化提问、维护多步任务清单。' },
	{ names: 'SkillTool / DiscoverSkillsTool', desc: '技能系统：按名加载技能，按描述搜索可用技能。' },
];

const scenes = [
	{ title: '代码审查', desc: '干净上下文 + 证据要求 + 独立复核——审查纪律打包成 skill，一句话触发。' },
	{ title: '大规模迁移', desc: 'Ultracode 并行扇出几十个 agent，探索、规划、实现、验证、汇总全自动。' },
	{ title: '代码库审计', desc: '多代理分片扫描整个仓库，模式识别与风险清单一次到位。' },
	{ title: '多维分析', desc: '同一问题从性能、安全、架构多角度并行分析，交叉验证结论。' },
];

const featureGroups = [
	{ id: 'engine', heading: '核心引擎', sub: '从单 Agent 循环到多代理编排', items: engineFeatures },
	{ id: 'model', heading: '模型与上下文', sub: '任何模型，用对每一分钱', items: modelFeatures },
	{ id: 'agent', heading: 'Agent 能力', sub: '工具、技能、子代理、自动化', items: agentFeatures },
	{ id: 'eco', heading: '生态与自动化', sub: '兼容既有生态，开箱即用', items: ecoFeatures },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Peri Code — 轻舟不扰，远山可渡 · Rust 开源 AI 编码助手</title>
		<meta name="description" content="Peri Code 是一个 Rust 编写的开源 AI 编码助手，兼容 Claude Code 生态与任何模型。轻舟不扰，远山可渡——只为助你解决真正的问题。" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
	</head>
	<body>
		<style>
			* { margin: 0; padding: 0; box-sizing: border-box; }

			body {
				font-family: var(--sl-font);
				background: var(--peri-bg);
				color: var(--peri-fg);
				line-height: 1.7;
				-webkit-font-smoothing: antialiased;
			}

			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 2rem;
			}

			/* ============================================
			   Navigation
			   ============================================ */
			.nav {
				position: sticky; top: 0; z-index: 100;
				background: var(--peri-bg);
				border-bottom: 1px solid var(--peri-hairline);
				display: flex; align-items: center; justify-content: space-between;
				padding: 0 2rem;
				height: 3.5rem;
			}
			.nav-logo {
				font-size: 1.1rem; font-weight: 400;
				color: var(--peri-fg);
				text-decoration: none;
				letter-spacing: 0.02em;
			}
			.nav-links { display: flex; gap: 1.75rem; list-style: none; }
			.nav-links a {
				text-decoration: none; color: var(--peri-muted); font-weight: 400;
				font-size: 0.9rem; transition: color 0.15s;
			}
			.nav-links a:hover { color: var(--peri-fg); text-decoration: underline; text-underline-offset: 0.3em; }

			/* ============================================
			   Hero — 左文右图
			   ============================================ */
			.hero {
				display: grid;
				grid-template-columns: 1fr 1fr;
				align-items: center;
				gap: 3rem;
				padding: 4.5rem 0 4rem;
			}
			.hero-eyebrow {
				font-size: 0.8rem; font-weight: 400; letter-spacing: 0.08em;
				text-transform: uppercase; color: var(--peri-clay);
				margin-bottom: 1.25rem;
			}
			.hero-title {
				font-size: clamp(2.6rem, 5vw, 3.8rem);
				font-weight: 300;
				line-height: 1.15;
				letter-spacing: 0.02em;
				color: var(--peri-fg);
				margin-bottom: 1.25rem;
			}
			.hero-tagline {
				display: block;
				font-weight: inherit;
				color: inherit;
				margin-top: 0.35rem;
				letter-spacing: inherit;
			}
			.hero-subtitle {
				font-size: 1.05rem;
				color: var(--peri-muted);
				max-width: 520px;
				margin-bottom: 2rem;
				line-height: 1.8;
			}
			.hero-actions {
				display: flex; gap: 0.75rem;
				flex-wrap: wrap;
			}
			.btn {
				display: inline-flex; align-items: center; gap: 0.5rem;
				padding: 0.55rem 1.25rem;
				border-radius: 8px;
				font-family: var(--sl-font); font-weight: 400;
				font-size: 0.95rem; text-decoration: none;
				transition: background 0.2s ease, color 0.2s ease;
				cursor: pointer; border: none;
			}
			.btn-primary {
				background: var(--peri-fg); color: var(--peri-bg);
				border: 1.5px solid var(--peri-fg);
			}
			.btn-primary:hover { background: var(--peri-btn-hover); }
			.btn-outline {
				background: transparent;
				color: var(--peri-fg);
				border: 1.5px solid var(--peri-fg);
			}
			.btn-outline:hover { background: var(--peri-fg); color: var(--peri-bg); }

			.hero-figure {
				position: relative;
			}
			.hero-figure img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 16px;
				border: 1px solid var(--peri-hairline);
				box-shadow: 0 1px 1px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.06);
			}
			.hero-figure figcaption {
				margin-top: 0.75rem;
				font-size: 0.8rem;
				color: var(--peri-faint);
				text-align: center;
			}

			/* ============================================
			   Metrics
			   ============================================ */
			.metrics {
				display: grid;
				grid-template-columns: repeat(6, 1fr);
				border-top: 1px solid var(--peri-hairline);
				border-bottom: 1px solid var(--peri-hairline);
			}
			.metric-item {
				text-align: center;
				padding: 1.8rem 0.75rem;
			}
			.metric-item + .metric-item {
				border-left: 1px solid var(--peri-hairline);
			}
			.metric-num {
				font-size: clamp(1.4rem, 2.2vw, 1.9rem);
				font-weight: 300; color: var(--peri-fg);
				line-height: 1.2; letter-spacing: 0.02em;
				white-space: nowrap;
			}
			.metric-label {
				font-size: 0.78rem; color: var(--peri-muted);
				margin-top: 0.25rem;
			}

			/* ============================================
			   Sections
			   ============================================ */
			.section {
				padding: 4.5rem 0;
			}
			.section + .section {
				border-top: 1px solid var(--peri-hairline);
			}
			.section-heading {
				font-size: clamp(1.6rem, 3vw, 2.1rem);
				font-weight: 300; color: var(--peri-fg);
				letter-spacing: 0.02em;
				margin-bottom: 2.5rem;
			}

			/* ---- 特性矩阵 ---- */
			.feature-group {
				margin-bottom: 3.5rem;
			}
			.feature-group:last-child { margin-bottom: 0; }
			.group-head {
				display: flex; align-items: baseline; gap: 1rem;
				margin-bottom: 1.75rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--peri-hairline);
			}
			.group-index {
				font-size: 1rem; font-weight: 300;
				color: var(--peri-clay); letter-spacing: 0.08em;
			}
			.group-title {
				font-size: 1.45rem; font-weight: 300;
				color: var(--peri-fg); letter-spacing: 0.02em;
			}
			.group-sub {
				font-size: 0.9rem; color: var(--peri-muted);
			}
			.feature-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2.2rem 2rem;
			}
			.feature-icon { font-size: 1.2rem; display: block; margin-bottom: 0.6rem; }
			.feature-title {
				font-size: 1rem; font-weight: 400;
				color: var(--peri-fg); margin-bottom: 0.4rem;
				letter-spacing: 0.02em;
			}
			.feature-desc {
				font-size: 0.9rem; color: var(--peri-muted); line-height: 1.65;
			}

			/* ---- 工具墙：大卡 ---- */
			.tool-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
			}
			.tool-card {
				padding: 1.4rem 1.25rem;
				border: 1px solid var(--peri-hairline);
				border-radius: 10px;
				transition: border-color 0.2s ease, transform 0.2s ease;
			}
			.tool-card:hover {
				border-color: var(--peri-fg);
				transform: translateY(-2px);
			}
			.tool-names {
				font-family: var(--sl-font-mono);
				font-size: 0.85rem;
				color: var(--peri-fg);
				margin-bottom: 0.5rem;
				line-height: 1.5;
			}
			.tool-desc {
				font-size: 0.85rem; color: var(--peri-muted); line-height: 1.6;
			}

			/* ---- 场景 ---- */
			.scene-row {
				display: grid;
				grid-template-columns: 10rem 1fr;
				gap: 1.5rem;
				padding: 1.25rem 0;
				border-top: 1px solid var(--peri-hairline);
			}
			.scene-row:last-of-type { border-bottom: 1px solid var(--peri-hairline); }
			.scene-title {
				font-size: 1rem; font-weight: 400;
				color: var(--peri-fg);
			}
			.scene-desc {
				font-size: 0.9rem; color: var(--peri-muted); line-height: 1.65;
			}

			/* ---- 最新发布 ---- */
			.post-row {
				display: grid;
				grid-template-columns: 8rem 1fr;
				gap: 1.5rem;
				padding: 1.5rem 0;
				border-top: 1px solid var(--peri-hairline);
				text-decoration: none;
			}
			.post-row:last-of-type { border-bottom: 1px solid var(--peri-hairline); }
			.post-cat {
				font-size: 0.8rem; font-weight: 400; letter-spacing: 0.04em;
				color: var(--peri-faint);
				padding-top: 0.2rem;
			}
			.post-title {
				font-size: 1.15rem; font-weight: 300;
				color: var(--peri-fg);
				margin-bottom: 0.4rem;
				letter-spacing: 0.02em;
				text-underline-offset: 0.2em;
			}
			.post-row:hover .post-title { text-decoration: underline; }
			.post-desc {
				font-size: 0.95rem; color: var(--peri-muted);
				line-height: 1.6;
			}

			/* ============================================
			   CTA
			   ============================================ */
			.cta {
				padding: 4.5rem 0 5rem;
				border-top: 1px solid var(--peri-hairline);
				text-align: center;
			}
			.cta-title {
				font-size: clamp(1.6rem, 3vw, 2.1rem);
				font-weight: 300; color: var(--peri-fg);
				margin-bottom: 1rem;
				letter-spacing: 0.02em;
			}
			.cta-desc {
				color: var(--peri-muted);
				max-width: 520px; margin: 0 auto 2rem;
			}
			.cta-code {
				display: block;
				background: var(--peri-code-bg);
				color: var(--peri-code-fg);
				padding: 1rem 1.5rem;
				border-radius: 8px;
				font-size: 0.9rem;
				margin-bottom: 2rem;
				font-family: var(--sl-font-mono);
				text-align: left;
				max-width: 640px; margin-left: auto; margin-right: auto;
				overflow-x: auto;
			}

			/* ============================================
			   Footer
			   ============================================ */
			.footer {
				border-top: 1px solid var(--peri-hairline);
				padding: 2rem;
				text-align: center;
				color: var(--peri-faint);
				font-size: 0.85rem;
			}
			.footer a { color: var(--peri-muted); text-decoration: underline; text-underline-offset: 0.2em; }
			.footer a:hover { color: var(--peri-fg); }

			/* ============================================
			   Responsive
			   ============================================ */
			@media (max-width: 900px) {
				.hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 3rem; }
				.hero-figure { order: -1; }
				.metrics { grid-template-columns: repeat(3, 1fr); }
				.metric-item:nth-child(4) { border-left: none; }
				.feature-grid { grid-template-columns: repeat(2, 1fr); }
				.tool-grid { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 640px) {
				.metrics { grid-template-columns: repeat(2, 1fr); }
				.metric-item:nth-child(3) { border-left: none; }
				.feature-grid { grid-template-columns: 1fr; }
				.tool-grid { grid-template-columns: 1fr; }
				.scene-row { grid-template-columns: 1fr; gap: 0.25rem; }
				.post-row { grid-template-columns: 1fr; gap: 0.25rem; }
				.nav-links { gap: 1rem; }
				.nav-links li:nth-child(n+3) { display: none; }
			}
		</style>

		<!-- ============ Navigation ============ -->
		<nav class="nav" aria-label="主导航">
			<a href={base} class="nav-logo">Peri Code</a>
			<ul class="nav-links">
				<li><a href={`${base}docs/get-started/introduction/`}>文档</a></li>
				<li><a href={`${base}posts/engineering/agent-loop/`}>工程</a></li>
				<li><a href={`${base}posts/product/demo-introducing-peri/`}>产品</a></li>
				<li><a href={`${base}posts/research/tool-behavior-fix-evidence/`}>研究</a></li>
				<li><a href={`${base}posts/news/demo-v2-release/`}>动态</a></li>
				<li><a href="https://github.com/konghayao/peri" target="_blank" rel="noopener">GitHub</a></li>
			</ul>
		</nav>

		<!-- ============ Hero ============ -->
		<section class="container hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="hero-eyebrow">铸于 Rust · 智无所择 · 迁而无痕</p>
				<h1 id="hero-title" class="hero-title">
					Peri Code
					<span class="hero-tagline">轻舟不扰，远山可渡</span>
				</h1>
				<p class="hero-subtitle">
					轻舟一叶，不扰清波，渡君至远山。以 Rust 铸就，十三兆之躯，
					兼容尔之所习——不为炫技，唯愿助君成事。
				</p>
				<div class="hero-actions">
					<a href={`${base}docs/get-started/introduction/`} class="btn btn-primary">登舟</a>
					<a href="https://github.com/konghayao/peri" class="btn btn-outline" target="_blank" rel="noopener">GitHub</a>
				</div>
			</div>
			<figure class="hero-figure">
				<img src={`${base}images/hero-cactus.png`} alt="Peri Code 手绘插画：终端、机器人与并行代理网络" width="1536" height="1024" />
				<figcaption>往复循环 · 众佐并行 · 上下自续</figcaption>
			</figure>
		</section>

		<!-- ============ Metrics ============ -->
		<div class="container metrics">
			{
				metrics.map((m) => (
					<div class="metric-item">
						<div class="metric-num">{m.num}</div>
						<div class="metric-label">{m.label}</div>
					</div>
				))
			}
		</div>

		<!-- ============ Feature matrix ============ -->
		<section class="container section" aria-labelledby="features-heading">
			<h2 id="features-heading" class="section-heading">诸器之能</h2>
			{
				featureGroups.map((group, gi) => (
					<div class="feature-group">
						<div class="group-head">
							<span class="group-index">{String(gi + 1).padStart(2, '0')}</span>
							<h3 class="group-title">{group.heading}</h3>
							<span class="group-sub">{group.sub}</span>
						</div>
						<div class="feature-grid">
							{
								group.items.map((f) => (
									<div>
										<span class="feature-icon">{f.icon}</span>
										<h4 class="feature-title">{f.title}</h4>
										<p class="feature-desc">{f.desc}</p>
									</div>
								))
							}
						</div>
					</div>
				))
			}
		</section>

		<!-- ============ Tools ============ -->
		<section class="container section" aria-labelledby="tools-heading">
			<h2 id="tools-heading" class="section-heading">十四器</h2>
			<div class="tool-grid">
				{
					toolCards.map((t) => (
						<div class="tool-card">
							<div class="tool-names">{t.names}</div>
							<p class="tool-desc">{t.desc}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- ============ Scenes ============ -->
		<section class="container section" aria-labelledby="scenes-heading">
			<h2 id="scenes-heading" class="section-heading">用武之地</h2>
			{
				scenes.map((s) => (
					<div class="scene-row">
						<h3 class="scene-title">{s.title}</h3>
						<p class="scene-desc">{s.desc}</p>
					</div>
				))
			}
		</section>

		<!-- ============ Latest posts ============ -->
		<section class="container section" aria-labelledby="latest-heading">
			<h2 id="latest-heading" class="section-heading">近讯</h2>
			{
				posts.map((post) => {
					const section = post.id.split('/')[0];
					const link = `${base}posts/${post.id.replace(/\.mdx$/, '')}/`;
					return (
						<a class="post-row" href={link}>
							<div class="post-cat">{sectionLabels[section] || section}</div>
							<div class="post-body">
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-desc">{post.data.description}</p>
							</div>
						</a>
					);
				})
			}
		</section>

		<!-- ============ CTA ============ -->
		<section class="container cta">
			<h2 class="cta-title">轻舟已备，待君启航</h2>
			<p class="cta-desc">
				安装一令而就，无需更张；初启之顷，自有人导君配置模型。
			</p>
			<code class="cta-code">
				curl -fsSL https://raw.githubusercontent.com/konghayao/peri/main/scripts/install.sh | bash
			</code>
			<a href={`${base}docs/get-started/introduction/`} class="btn btn-primary">观其全章</a>
		</section>

		<!-- ============ Footer ============ -->
		<footer class="footer">
			<p>由 <a href="https://github.com/konghayao/peri" target="_blank" rel="noopener">Peri Code</a> 团队构建 ·
			<a href="https://github.com/konghayao/peri" target="_blank" rel="noopener">GitHub</a> ·
			Apache 2.0 许可证</p>
		</footer>
	</body>
</html>
