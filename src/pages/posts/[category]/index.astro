---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	getPostCategory,
	getFeaturedPost,
	resolveFeaturedPost,
	postCategories,
	postPath,
	postSidebar,
	postsByTopic,
	postsInCategory,
} from '../../../lib/content';

export function getStaticPaths() {
	return postCategories.map((category) => ({ params: { category: category.id } }));
}

const category = getPostCategory(Astro.params.category ?? '');
const posts = postsInCategory(await getCollection('posts'), category.id);
const featured = import.meta.env.DEV
	? resolveFeaturedPost(posts, category.id)
	: getFeaturedPost(posts, category.id);
const topicGroups = postsByTopic(posts, category.id);
const base = import.meta.env.BASE_URL;
const sidebar = postSidebar(posts, category.id);
---

<StarlightPage
	frontmatter={{ title: category.label, description: category.description }}
	sidebar={sidebar}
	tableOfContents={false}
>
	<p class="category-promise">{category.promise}</p>
	<section class="featured-post" data-post={postPath(featured).replace(/^posts\//, '').replace(/\/$/, '')}>
		<p class="section-label">从这里开始</p>
		<h2><a href={`${base}${postPath(featured)}`}>{featured.data.title}</a></h2>
		<p>{featured.data.description}</p>
	</section>
	<section class="topic-map" aria-labelledby="topic-map-title">
		<div class="topic-map-heading">
			<p class="section-label">主题地图</p>
			<h2 id="topic-map-title">按问题进入</h2>
		</div>
		{
			topicGroups.map(({ topic, posts }, index) => (
				<a class="topic-card" href={`#topic-${topic.id}`}>
					<span class="topic-index">{String(index + 1).padStart(2, '0')}</span>
					<span class="topic-card-body">
						<strong>{topic.label}</strong>
						<span>{topic.description}</span>
					</span>
					<span class="topic-count">{posts.length} 篇</span>
				</a>
			))
		}
	</section>
	<div class="topic-sections">
		{
			topicGroups.map(({ topic, posts }, index) => {
				const visiblePosts = posts.filter((post) => post.id !== featured.id);
				return (
					<section class="topic-section" id={`topic-${topic.id}`} data-topic={topic.id}>
						<header>
							<span class="topic-index">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h2>{topic.label}</h2>
								<p>{topic.description}</p>
							</div>
						</header>
						{posts.some((post) => post.id === featured.id) && (
							<p class="featured-in-topic">代表文章已在页首展示 · <a href={`${base}${postPath(featured)}`}>{featured.data.title}</a></p>
						)}
						<div class="post-list">
							{visiblePosts.map((post) => (
								<article data-post={postPath(post).replace(/^posts\//, '').replace(/\/$/, '')}>
									{post.data.date && <p class="post-date">{post.data.date.toISOString().slice(0, 10)}</p>}
									<h3><a href={`${base}${postPath(post)}`}>{post.data.title}</a></h3>
									<p>{post.data.description}</p>
								</article>
							))}
						</div>
					</section>
				);
			})
		}
	</div>
	<aside class="category-boundary">
		<strong>栏目边界</strong>
		<p>{category.boundary}</p>
	</aside>
</StarlightPage>

<style>
	.category-promise { font-size: 1.15rem; max-width: 48rem; }
	.featured-post { border-block: 1px solid var(--sl-color-gray-5); margin: 2rem 0; padding: 1.5rem 0; }
	.featured-post h2 { margin: 0.35rem 0 0.5rem; }
	.section-label { color: var(--sl-color-text-accent); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; margin: 0; text-transform: uppercase; }
	.topic-map { margin: 2.5rem 0 3.5rem; }
	.topic-map-heading h2 { margin: 0.3rem 0 1.25rem; }
	.topic-card { align-items: center; border-top: 1px solid var(--sl-color-gray-5); color: inherit; display: grid; gap: 1rem; grid-template-columns: 2.5rem minmax(0, 1fr) auto; padding: 1rem 0; text-decoration: none; }
	.topic-card:last-child { border-bottom: 1px solid var(--sl-color-gray-5); }
	.topic-card:hover strong { color: var(--sl-color-text-accent); }
	.topic-card:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 4px; }
	.topic-index { color: var(--sl-color-text-accent); font-size: 0.78rem; font-variant-numeric: tabular-nums; font-weight: 700; letter-spacing: 0.08em; }
	.topic-card-body { display: grid; gap: 0.2rem; }
	.topic-card-body strong { font-size: 1.05rem; }
	.topic-card-body span { color: var(--sl-color-gray-2); }
	.topic-count { color: var(--sl-color-gray-3); font-size: 0.8rem; white-space: nowrap; }
	.topic-sections { display: grid; gap: 3.5rem; }
	.topic-section { scroll-margin-top: 5rem; }
	.topic-section > header { align-items: start; border-left: 3px solid var(--sl-color-text-accent); display: grid; gap: 0.75rem; grid-template-columns: 2.5rem minmax(0, 1fr); padding-left: 1rem; }
	.topic-section > header h2 { margin: 0; }
	.topic-section > header p { color: var(--sl-color-gray-2); margin: 0.35rem 0 0; }
	.featured-in-topic { color: var(--sl-color-gray-3); font-size: 0.85rem; margin: 1.1rem 0 0; }
	.post-list article { border-top: 1px solid var(--sl-color-gray-5); padding: 1.4rem 0; }
	.post-list h3 { font-size: 1.25rem; margin: 0.25rem 0 0.5rem; }
	.post-date { margin: 0; color: var(--sl-color-gray-3); font-size: 0.85rem; }
	.category-boundary { border-top: 1px solid var(--sl-color-gray-5); margin-top: 2rem; padding-top: 1rem; color: var(--sl-color-gray-2); }
	.category-boundary p { margin-top: 0.35rem; }
	@media (max-width: 40rem) {
		.topic-card { align-items: start; grid-template-columns: 2rem minmax(0, 1fr); }
		.topic-count { grid-column: 2; }
	}
</style>
