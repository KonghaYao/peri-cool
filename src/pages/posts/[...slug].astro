---
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	getPostCategory,
	getPostCategoryId,
	postPath,
	postsByTopic,
	postsInCategory,
	sortPosts,
} from '../../lib/content';

export async function getStaticPaths() {
	const posts = sortPosts(await getCollection('posts'));
	return posts.map((post) => ({
		params: { slug: post.id.replace(/\.mdx$/, '') },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const hero = post.data.hero;

const section = getPostCategoryId(post);
const sectionMetadata = getPostCategory(section);
const allSectionPosts = postsInCategory(await getCollection('posts'), section);
const topicGroups = postsByTopic(allSectionPosts, section);

const base = import.meta.env.BASE_URL;

const toSidebarItem = (p: (typeof allSectionPosts)[number]) => ({
	label: p.data.title,
	link: `/${postPath(p)}`,
});

const sidebar = [
	{
		label: sectionMetadata.label,
		items: topicGroups.map(({ topic, posts }) => ({
			label: topic.label,
			items: posts.map(toSidebarItem),
		})),
	},
];
---

<StarlightPage
	frontmatter={{
		title: post.data.title,
		...(hero
			? { hero: { ...hero, tagline: hero.tagline ?? post.data.description } }
			: {}),
	}}
	sidebar={sidebar}
	tableOfContents={{}}
	headings={headings}
>
	{
		post.data.date && (
			<p style="margin: 0 0 1.5rem; color: var(--sl-color-gray-3); font-size: 0.85rem;">
				编写于 {post.data.date.toISOString().slice(0, 10)}
			</p>
		)
	}
	<Content />
</StarlightPage>
