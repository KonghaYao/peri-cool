---
import DocsLayout from "../../layouts/DocsLayout.astro";
import PostHero from "../../components/ui/post-hero/PostHero.astro";
import {
	getCollectionPage,
	getCollectionStaticPaths,
	getEditUrl,
	getLastUpdated,
	getRouteFlags,
	getTOC,
	stripBase,
} from "@cloudflare/nimbus-docs/runtime";
import { components } from "../../components";
import { getPostCategoryId, postSidebar, sortPosts } from "../../lib/content";
import { resolveHeroImage } from "../../lib/hero-image";
import { toNimbusSidebar } from "../../lib/post-sidebar";
import { getCollection } from "astro:content";

export const prerender = true;
export const getStaticPaths = getCollectionStaticPaths("posts");

const page = await getCollectionPage<"posts">(Astro);
if (page instanceof Response) return page;
const { entry, Content, headings, markdownUrl, ogImageUrl } = page;

const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const { tableOfContents: tocOn } = await getRouteFlags(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;

// 文章侧栏按「主题」分组（lib/content.ts 的治理模型），不是 Nimbus 默认
// 的按目录自动生成——文章分类是内容归属，不参与侧栏层级。
const posts = sortPosts(await getCollection("posts"));
const sidebar = toNimbusSidebar(postSidebar(posts, getPostCategoryId(entry)));

const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry));
const socialImage = entry.data.socialImage ?? ogImageUrl;
const hero = entry.data.hero;
const heroImage = hero ? resolveHeroImage(hero.image.file, entry.filePath) : undefined;
---

<DocsLayout
	title={entry.data.title}
	description={entry.data.description}
	sidebar={sidebar}
	headings={toc}
	prevNext={false}
	breadcrumbs={false}
	mode={entry.data.mode}
	banner={entry.data.banner}
	head={entry.data.head}
	searchable={entry.data.searchable}
	noindex={entry.data.noindex}
	markdownUrl={markdownUrl}
	socialImage={socialImage}
	lastUpdated={lastUpdated}
	editUrl={editUrl}
	draft={entry.data.draft}
	collection={entry.collection}
	entryId={entry.id}
	pageHero={Boolean(heroImage)}
>
	{heroImage && <PostHero slot="page-hero" image={heroImage} alt={hero.image.alt} />}
	{
		entry.data.date && (
			<p class="post-date">编写于 {entry.data.date.toISOString().slice(0, 10)}</p>
		)
	}
	<Content components={components} />
</DocsLayout>

<style>
	.post-date {
		margin: 0 0 1.5rem;
		color: var(--nb-muted-foreground);
		font-size: 0.85rem;
	}
</style>
